# Copiar como .env en la raíz del proyecto Salesforce, junto a sfdx-project.json.
# Mantener .env fuera de Git. La autenticación se gestiona con Salesforce CLI.

# Nombre base del proyecto, sin el sufijo de ambiente.
SF_PROJECT_NAME=autos

# dev, uat o prd. Con estos valores, el alias de Salesforce CLI es autos-dev.
# La preparación de paquetes y el despliegue rápido admiten dev y uat.
SF_ENV=dev

# Obligatoria si el manifiesto no aporta clases de prueba Apex.
# Sustituir por el nombre API de una clase de prueba que exista en la org destino.
# Si el manifiesto ya aporta pruebas, esta variable se puede omitir.
SF_VALIDATION_TEST_CLASS=RevisionCotizacionFunctionalTest
